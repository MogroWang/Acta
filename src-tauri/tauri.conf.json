{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acta · 行记",
  "version": "3.4.0",
  "identifier": "com.mws.acta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Acta · 行记",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#ebe7dc",
        "visible": false,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "本地优先的笔记与待办应用",
    "longDescription": "Acta · 行记把笔记、待办与日历放在一个安静、可掌控的本地空间中。",
    "copyright": "Copyright © MogroWang Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
