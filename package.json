{
  "name": "acta",
  "version": "3.2.0",
  "description": "Acta 行记 — notes and tasks, in one calm workspace.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --outDir docs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "start": "tauri dev",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test": "node scripts/smoke-test.js",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "windows:build": "tauri build --bundles nsis --target x86_64-pc-windows-msvc",
    "windows:portable": "tauri build --no-bundle --target x86_64-pc-windows-msvc",
    "macos:build": "tauri build --bundles app,dmg --target aarch64-apple-darwin"
  },
  "keywords": [
    "vite",
    "vue",
    "capacitor",
    "tauri",
    "notes",
    "tasks"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "MogroWang Studio",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "pdf-lib": "^1.17.1",
    "vue": "^3.5.43"
  }
}
