{
  "name": "acta",
  "version": "1.2.0",
  "description": "Acta 行记 — notes and tasks, in one calm workspace.",
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test": "node scripts/smoke-test.js",
    "android:sync": "cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "windows:build": "tauri build --bundles nsis --target x86_64-pc-windows-msvc",
    "windows:portable": "tauri build --no-bundle --target x86_64-pc-windows-msvc",
    "macos:build": "tauri build --bundles app,dmg --target universal-apple-darwin"
  },
  "keywords": [
    "tauri",
    "notes",
    "tasks"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "MogroWang Studio",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@tauri-apps/cli": "^2.11.4",
    "puppeteer-core": "^24.43.1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/status-bar": "^8.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "pdf-lib": "^1.17.1"
  }
}
